{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/ai/:path*",
      "destination": "/api/admin/ai?path=:path*"
    },
    {
      "source": "/api/games/:path*",
      "destination": "/api/games?path=:path*"
    },
    {
      "source": "/api/meta/:path*",
      "destination": "/api/meta?path=:path*"
    },
    {
      "source": "/watch/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|Googlebot|bingbot|Applebot|Pinterest|vkShare).*"
        }
      ],
      "destination": "/api/watch?id=:id"
    },
    {
      "source": "/watch/:id",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/status/cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}
