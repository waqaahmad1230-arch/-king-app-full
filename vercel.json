{
  "rewrites": [
    {
      "source": "/watch/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|Googlebot|bingbot|Applebot|Pinterest|vkShare).*"
        }
      ],
      "destination": "/api/watch?id=:id"
    },
    {
      "source": "/watch/:id",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/status/cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}
