{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with Facebook auto-ads consent",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "provider": { "type": "string" },
        "fb_auto_ads": { "type": "boolean" },
        "consentedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" },
        "statusPrivacy": { "type": "object" }
      },
      "required": ["uid"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public profile details of a KING channel creator, including name, photo, and social links",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "name": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "subscribersCount": { "type": "number" },
        "socialLinks": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "Download": {
      "title": "Download",
      "description": "Video download record for offline or library viewing",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "title": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "downloadedAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["videoId", "title", "downloadedAt"]
    },
    "KingGame": {
      "title": "KingGame",
      "description": "HTML5 game item, including GamePix property PN8G3 instant games",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "source": { "type": "string" },
        "url": { "type": "string" },
        "link": { "type": "string" },
        "thumbnail": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "rating": { "type": "number" },
        "plays": { "type": "string" },
        "status": { "type": "string" },
        "approved": { "type": "boolean" },
        "isApproved": { "type": "boolean" },
        "featuredOnHome": { "type": "boolean" },
        "discoveredAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "url", "category"]
    },
    "UserUploadedGame": {
      "title": "UserUploadedGame",
      "description": "Game submitted by user for review",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "gameFileUrl": { "type": "string" },
        "gameUrl": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "plays": { "type": "number" },
        "earnings": { "type": "number" }
      },
      "required": ["title", "userId", "status", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Admin notifications for user uploads",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "message": { "type": "string" },
        "gameId": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["userId", "message", "timestamp", "read"]
    },
    "Video": {
      "title": "Video",
      "description": "Video document with numeric likes and views counters",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "userId": { "type": "string" },
        "uid": { "type": "string" },
        "uploaderName": { "type": "string" },
        "channelName": { "type": "string" },
        "uploaderPhoto": { "type": "string" },
        "channelAvatar": { "type": "string" },
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "commentsCount": { "type": "number" },
        "publicationStatus": { "type": "string" },
        "contentType": { "type": "string" },
        "createdAt": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["title", "userId"]
    },
    "VideoLike": {
      "title": "VideoLike",
      "description": "Unique like record per user for a video",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "VideoView": {
      "title": "VideoView",
      "description": "Unique view record per viewer (authenticated UID or session guest ID) for a video",
      "type": "object",
      "properties": {
        "viewerId": { "type": "string" },
        "isGuest": { "type": "boolean" },
        "viewedAt": { "type": "string" }
      },
      "required": ["viewerId"]
    },
    "CatalogProduct": {
      "title": "CatalogProduct",
      "description": "Product item for KING Shop shopping catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "originalPrice": { "type": "number" },
        "discountPrice": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "imageUrls": {
          "type": "array"
        },
        "videoUrls": {
          "type": "array"
        },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "originalPrice", "stock", "category", "imageUrls", "isActive"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Canonical friend request or accepted friendship between two users",
      "type": "object",
      "properties": {
        "userA": { "type": "string" },
        "userB": { "type": "string" },
        "users": { "type": "array" },
        "status": { "type": "string" },
        "requestedBy": { "type": "string" },
        "targetUid": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userA", "userB", "users", "status", "requestedBy", "targetUid"]
    },
    "Follow": {
      "title": "Follow",
      "description": "One-way follow edge from followerUid to targetUid",
      "type": "object",
      "properties": {
        "followerUid": { "type": "string" },
        "targetUid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["followerUid", "targetUid"]
    },
    "Block": {
      "title": "Block",
      "description": "Block record preventing social interaction between two users",
      "type": "object",
      "properties": {
        "blockerUid": { "type": "string" },
        "blockedUid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["blockerUid", "blockedUid"]
    },
    "Status": {
      "title": "Status",
      "description": "24-hour expiring Status update (photo, video up to 60s, or text) with privacy controls",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "type": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "cloudinaryPublicId": { "type": "string" },
        "cloudinaryResourceType": { "type": "string" },
        "cloudinaryDeliveryType": { "type": "string" },
        "caption": { "type": "string" },
        "textContent": { "type": "string" },
        "bgGradient": { "type": "string" },
        "textStyle": { "type": "string" },
        "durationSec": { "type": "number" },
        "audioTrack": { "type": "object" },
        "whatsappCta": { "type": "object" },
        "videoEdits": { "type": "object" },
        "privacyMode": { "type": "string" },
        "allowedUids": { "type": "array" },
        "excludedUids": { "type": "array" },
        "viewsCount": { "type": "number" },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["authorUid", "type", "privacyMode", "createdAt", "expiresAt"]
    },
    "StatusView": {
      "title": "StatusView",
      "description": "Unique view record per viewer per status (statusId_viewerUid)",
      "type": "object",
      "properties": {
        "statusId": { "type": "string" },
        "statusOwnerUid": { "type": "string" },
        "viewerUid": { "type": "string" },
        "viewerName": { "type": "string" },
        "viewerPhoto": { "type": "string" },
        "viewedAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["statusId", "statusOwnerUid", "viewerUid"]
    },
    "StatusLike": {
      "title": "StatusLike",
      "description": "Unique reaction per user per status (statusId_userUid)",
      "type": "object",
      "properties": {
        "statusId": { "type": "string" },
        "statusOwnerUid": { "type": "string" },
        "userUid": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "emoji": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["statusId", "statusOwnerUid", "userUid", "emoji"]
    },
    "StatusReply": {
      "title": "StatusReply",
      "description": "Private reply from a viewer to a status owner",
      "type": "object",
      "properties": {
        "statusId": { "type": "string" },
        "statusOwnerUid": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["statusId", "statusOwnerUid", "senderUid", "message"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Social & Status reaction/reply notifications for users",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "actorPhoto": { "type": "string" },
        "type": { "type": "string" },
        "statusId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "emoji": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["recipientUid", "actorUid", "type", "title", "read"]
    },
    "UserPost": {
      "title": "UserPost",
      "description": "User published photo or social post shown in Home Community Feed",
      "type": "object",
      "properties": {
        "contentType": { "type": "string" },
        "publicationStatus": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "caption": { "type": "string" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "lastCommentId": { "type": "string" },
        "lastDeletedCommentId": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["contentType", "publicationStatus", "authorUid", "mediaUrl", "createdAt"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Unique like record per user on a UserPost",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "FeedComment": {
      "title": "FeedComment",
      "description": "Comment on a UserPost or Video document",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["authorUid", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and ad consent document"
    },
    "/publicProfiles/{userId}": {
      "schema": "PublicProfile",
      "description": "Public channel profile and social catalog links for a user"
    },
    "/users/{userId}/downloads/{downloadId}": {
      "schema": "Download",
      "description": "Video download record for a user"
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Uploaded video post with atomic likes and views counters"
    },
    "/videos/{videoId}/likes/{userId}": {
      "schema": "VideoLike",
      "description": "Unique like by a user on a video"
    },
    "/videos/{videoId}/views/{viewerId}": {
      "schema": "VideoView",
      "description": "Unique view by a user or guest on a video"
    },
    "/king_games/{gameId}": {
      "schema": "KingGame",
      "description": "Catalog of verified and pending HTML5 games including GamePix PN8G3"
    },
    "/user_uploaded_games/{gameId}": {
      "schema": "UserUploadedGame",
      "description": "Games submitted by users for approval"
    },
    "/user_notifications/{notificationId}": {
      "schema": "UserNotification",
      "description": "Notifications for users"
    },
    "/catalog_products/{productId}": {
      "schema": "CatalogProduct",
      "description": "Shopping catalog products collection"
    },
    "/friendships/{pairId}": {
      "schema": "Friendship",
      "description": "Friend requests and accepted friendships keyed by sorted minUid_maxUid"
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "Follow relationships keyed by followerUid_targetUid"
    },
    "/blocks/{blockId}": {
      "schema": "Block",
      "description": "User block records keyed by blockerUid_blockedUid"
    },
    "/statuses/{statusId}": {
      "schema": "Status",
      "description": "24-hour expiring Status updates"
    },
    "/status_views/{viewId}": {
      "schema": "StatusView",
      "description": "Unique view records per status and viewer"
    },
    "/status_likes/{likeId}": {
      "schema": "StatusLike",
      "description": "Unique emoji reactions per status and user"
    },
    "/status_replies/{replyId}": {
      "schema": "StatusReply",
      "description": "Private replies to Status updates"
    },
    "/videos/{videoId}/comments/{commentId}": {
      "schema": "FeedComment",
      "description": "User comments on an uploaded video"
    },
    "/user_posts/{postId}": {
      "schema": "UserPost",
      "description": "User published photo posts for Home Social Feed"
    },
    "/user_posts/{postId}/likes/{userId}": {
      "schema": "PostLike",
      "description": "Unique like per user on a user post"
    },
    "/user_posts/{postId}/comments/{commentId}": {
      "schema": "FeedComment",
      "description": "User comments on a user post"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications for status reactions and replies"
    }
  }
}
