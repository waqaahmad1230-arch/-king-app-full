rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Single Authorized Super Admin Email
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == "waqaahmad1230@gmail.com";
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    // Safe ownership check supporting legacy 'uid' and standard 'userId' without missing-field crashes
    function isVideoOwner(videoData) {
      return isSignedIn() && videoData != null && (
        (('userId' in videoData) && videoData.userId == request.auth.uid) ||
        (('uid' in videoData) && videoData.uid == request.auth.uid)
      );
    }

    // Safe numeric extraction for likes (handles missing, null, or number type)
    function getDocLikes(docData) {
      return (docData != null && ('likes' in docData) && docData.likes is number) ? docData.likes : 0;
    }

    // Safe numeric extraction for views (handles missing, null, or number type)
    function getDocViews(docData) {
      return (docData != null && ('views' in docData) && docData.views is number) ? docData.views : 0;
    }

    // Validate Firestore document IDs and UIDs to prevent path/regex metacharacter injection
    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validate future Status visibility privacy config stored privately on /users/{userId}
    function isValidStatusPrivacy(p) {
      return p is map &&
        p.keys().hasAll(['visibility', 'selectedUids', 'exceptUids']) &&
        p.keys().hasOnly(['visibility', 'selectedUids', 'exceptUids', 'updatedAt']) &&
        p.visibility in ['public', 'friends', 'followers', 'selected', 'except', 'only_me'] &&
        p.selectedUids is list &&
        p.selectedUids.size() <= 200 &&
        (p.selectedUids.size() == 0 || isValidId(p.selectedUids[0])) &&
        p.exceptUids is list &&
        p.exceptUids.size() <= 200 &&
        (p.exceptUids.size() == 0 || isValidId(p.exceptUids[0])) &&
        (!('updatedAt' in p) || (p.updatedAt is string && p.updatedAt.size() <= 64) || p.updatedAt is timestamp);
    }

    // Check if either user has blocked the other
    function isBlockedBetween(uid1, uid2) {
      return exists(/databases/$(database)/documents/blocks/$(uid1 + '_' + uid2)) ||
             exists(/databases/$(database)/documents/blocks/$(uid2 + '_' + uid1));
    }

    // Check if two users have an accepted mutual friendship
    function isAcceptedFriend(uid1, uid2) {
      return uid1 < uid2
        ? (exists(/databases/$(database)/documents/friendships/$(uid1 + '_' + uid2)) &&
           get(/databases/$(database)/documents/friendships/$(uid1 + '_' + uid2)).data.status == 'accepted')
        : (exists(/databases/$(database)/documents/friendships/$(uid2 + '_' + uid1)) &&
           get(/databases/$(database)/documents/friendships/$(uid2 + '_' + uid1)).data.status == 'accepted');
    }

    // Safe numeric extraction helper for counters
    function getDocCounter(docData, fieldName) {
      return (docData != null && (fieldName in docData) && docData[fieldName] is number && docData[fieldName] >= 0)
        ? docData[fieldName]
        : 0;
    }

    // Enforce Status visibility, 24h expiry, and bidirectional blocks on single-doc gets and relational checks
    function canViewStatusDoc(statusData) {
      return isAdmin() || (
        isSignedIn() &&
        statusData != null && (
          statusData.authorUid == request.auth.uid || (
            ('expiresAt' in statusData) &&
            statusData.expiresAt is timestamp &&
            statusData.expiresAt > request.time &&
            !isBlockedBetween(request.auth.uid, statusData.authorUid) && (
              statusData.privacyMode == 'public' ||
              (statusData.privacyMode == 'selected' && ('allowedUids' in statusData) && statusData.allowedUids is list && request.auth.uid in statusData.allowedUids) ||
              (statusData.privacyMode == 'except' && (isAcceptedFriend(request.auth.uid, statusData.authorUid) || exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + statusData.authorUid))) && (!('excludedUids' in statusData) || (statusData.excludedUids is list && !(request.auth.uid in statusData.excludedUids)))) ||
              (statusData.privacyMode == 'friends' && isAcceptedFriend(request.auth.uid, statusData.authorUid)) ||
              (statusData.privacyMode == 'followers' && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + statusData.authorUid)))
            )
          )
        )
      );
    }

    // Validate Status audioTrack map
    function isValidAudioTrack(track) {
      return track is map &&
        track.keys().hasAll(['mode', 'label']) &&
        track.keys().hasOnly(['mode', 'label', 'presetId', 'audioUrl', 'cloudinaryPublicId']) &&
        track.mode in ['original', 'royalty_free', 'custom_audio'] &&
        track.label is string && track.label.size() <= 100 &&
        (!('presetId' in track) || (track.presetId is string && track.presetId.size() <= 64)) &&
        (!('audioUrl' in track) || (track.audioUrl is string && track.audioUrl.size() <= 2000)) &&
        (!('cloudinaryPublicId' in track) || (track.cloudinaryPublicId is string && track.cloudinaryPublicId.size() <= 500));
    }

    // Validate new Status payload on create
    function isValidStatusCreate(data) {
      return data.keys().hasAll([
          'authorUid', 'authorName', 'authorPhoto', 'type', 'mediaUrl', 'thumbnailUrl',
          'cloudinaryPublicId', 'cloudinaryResourceType', 'cloudinaryDeliveryType',
          'caption', 'textContent', 'bgGradient', 'textStyle', 'durationSec',
          'audioTrack', 'privacyMode', 'allowedUids', 'excludedUids',
          'viewsCount', 'likesCount', 'createdAt', 'expiresAt'
        ]) &&
        data.keys().hasOnly([
          'authorUid', 'authorName', 'authorPhoto', 'type', 'mediaUrl', 'thumbnailUrl',
          'cloudinaryPublicId', 'cloudinaryResourceType', 'cloudinaryDeliveryType',
          'caption', 'textContent', 'bgGradient', 'textStyle', 'durationSec',
          'audioTrack', 'privacyMode', 'allowedUids', 'excludedUids',
          'viewsCount', 'likesCount', 'createdAt', 'expiresAt'
        ]) &&
        isValidId(request.auth.uid) &&
        data.authorUid == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        data.authorPhoto is string && data.authorPhoto.size() <= 1000 &&
        data.type in ['image', 'video', 'text'] &&
        data.mediaUrl is string && data.mediaUrl.size() <= 2000 &&
        data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2000 &&
        data.cloudinaryPublicId is string && data.cloudinaryPublicId.size() <= 500 &&
        data.cloudinaryResourceType in ['image', 'video', 'raw', ''] &&
        data.cloudinaryDeliveryType in ['upload', 'authenticated', 'none'] &&
        data.caption is string && data.caption.size() <= 300 &&
        data.textContent is string && data.textContent.size() <= 700 &&
        data.bgGradient is string && data.bgGradient.size() <= 120 &&
        data.textStyle in ['classic', 'bold', 'editorial', 'mono'] &&
        data.durationSec is number && data.durationSec >= 0 && data.durationSec <= 60 &&
        isValidAudioTrack(data.audioTrack) &&
        data.privacyMode in ['public', 'friends', 'followers', 'selected', 'except', 'only_me'] &&
        data.allowedUids is list && data.allowedUids.size() <= 200 &&
        (data.allowedUids.size() == 0 || isValidId(data.allowedUids[0])) &&
        data.excludedUids is list && data.excludedUids.size() <= 200 &&
        (data.excludedUids.size() == 0 || isValidId(data.excludedUids[0])) &&
        data.viewsCount == 0 &&
        data.likesCount == 0 &&
        data.createdAt == request.time &&
        data.expiresAt is timestamp &&
        data.expiresAt > request.time &&
        data.expiresAt <= request.time + duration.value(25, 'h');
    }

    // --- catalog_products Collection ---
    // Public can see King Catalog; writes strictly restricted to Super Admin
    match /catalog_products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Owner can get their own document; only Super Admin can list all users
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['isAdmin', 'admin', 'role', 'permissions', 'isSuperAdmin']) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('statusPrivacy' in request.resource.data) || isValidStatusPrivacy(request.resource.data.statusPrivacy))
      );
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'admin', 'role', 'permissions', 'isSuperAdmin']) &&
        (!('uid' in request.resource.data.diff(resource.data).affectedKeys()) || (('uid' in request.resource.data) && request.resource.data.uid == userId)) &&
        (!('statusPrivacy' in request.resource.data.diff(resource.data).affectedKeys()) || (('statusPrivacy' in request.resource.data) && isValidStatusPrivacy(request.resource.data.statusPrivacy)))
      );
      allow delete: if isAdmin();

      // Nested Subcollection: /users/{userId}/channel_uploads/{uploadId}
      match /channel_uploads/{uploadId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // Nested Subcollection: /users/{userId}/downloads/{downloadId}
      match /downloads/{downloadId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- Public Profiles Collection ---
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'name', 'photoURL', 'bio', 'socialLinks', 'createdAt', 'updatedAt'
        ]) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId)
      );
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'name', 'photoURL', 'bio', 'socialLinks', 'createdAt', 'updatedAt'
        ]) &&
        (!('uid' in request.resource.data.diff(resource.data).affectedKeys()) || (('uid' in request.resource.data) && request.resource.data.uid == userId))
      );
      allow delete: if isAdmin();
    }

    // --- Videos Collection ---
    match /videos/{videoId} {
      // 1. Public can read all videos
      allow read: if true;

      // 2. Authenticated user can create their own video
      allow create: if isSignedIn() && (
        (('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
         ('uid' in request.resource.data && request.resource.data.uid == request.auth.uid)) ||
        isAdmin()
      );

      // 3. Strict update logic: exactly one branch must be satisfied
      allow update: if (
        // Branch A: Super Admin full access
        isAdmin() ||

        // Branch B: Video creator metadata update (strictly excludes ownership, URLs, createdAt, and counters)
        (
          isVideoOwner(resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'userId', 'uid', 'url', 'videoUrl', 'createdAt', 'likes', 'views'
          ])
        ) ||

        // Branch C1: Atomic Like increment (+1) coupled with like document creation
        (
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          request.resource.data.likes == (getDocLikes(resource.data) + 1) &&
          !exists(/databases/$(database)/documents/videos/$(videoId)/likes/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/videos/$(videoId)/likes/$(request.auth.uid))
        ) ||

        // Branch C2: Atomic Unlike decrement (-1) coupled with like document deletion
        (
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          request.resource.data.likes == (getDocLikes(resource.data) > 0 ? getDocLikes(resource.data) - 1 : 0) &&
          exists(/databases/$(database)/documents/videos/$(videoId)/likes/$(request.auth.uid)) &&
          !existsAfter(/databases/$(database)/documents/videos/$(videoId)/likes/$(request.auth.uid))
        ) ||

        // Branch D: Atomic View increment (+1) strictly requiring authenticated viewer and view doc creation
        (
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
          request.resource.data.views == (getDocViews(resource.data) + 1) &&
          !exists(/databases/$(database)/documents/videos/$(videoId)/views/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/videos/$(videoId)/views/$(request.auth.uid))
        )
      );

      // 4. Video deletion (Creator or Super Admin only)
      allow delete: if isSignedIn() && (isVideoOwner(resource.data) || isAdmin());

      // --- Likes Subcollection: /videos/{videoId}/likes/{userId} ---
      match /likes/{userId} {
        allow read: if true;

        // Atomic Like creation: caller must own the like document, fields whitelist, and parent video must exist
        // Note: The atomic +1 increment and existsAfter pairing is strictly verified by the parent video rule
        allow create: if isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'createdAt']) &&
          exists(/databases/$(database)/documents/videos/$(videoId));

        // Atomic Unlike deletion: must be like owner (or Super Admin)
        allow delete: if isAdmin() || (
          isSignedIn() &&
          request.auth.uid == userId
        );

        allow update: if false;
      }

      // --- Views Subcollection: /videos/{videoId}/views/{viewerId} ---
      match /views/{viewerId} {
        allow read: if (isSignedIn() && request.auth.uid == viewerId) || isAdmin();

        // Atomic View creation: authenticated viewer only, viewerId matches caller, parent video must exist
        // Note: The atomic +1 view count increment and existsAfter pairing is strictly verified by the parent video rule
        allow create: if isSignedIn() &&
          request.auth.uid == viewerId &&
          request.resource.data.viewerId == request.auth.uid &&
          exists(/databases/$(database)/documents/videos/$(videoId));

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // --- king_games Collection ---
    // Public read; writes strictly restricted to Super Admin
    match /king_games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- user_uploaded_games Collection ---
    // User submits game drafts for review; protected by creation and update whitelists; Admin approves or rejects
    match /user_uploaded_games/{gameId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'title', 'category', 'description', 'thumbnailUrl', 'gameUrl',
          'status', 'createdAt', 'plays', 'earnings',
          'gameOverText', 'template', 'speed', 'jump', 'gap', 'difficulty', 'control',
          'bgColor', 'map', 'pipeStyle', 'building', 'decoration', 'isEngineGame', 'isPhase2',
          'playerEmoji', 'playerBase64', 'bgBase64', 'obstacleType', 'gapSize', 'levels'
        ]) &&
        (!('plays' in request.resource.data) || (request.resource.data.plays is number && request.resource.data.plays == 0)) &&
        (!('earnings' in request.resource.data) || (request.resource.data.earnings is number && request.resource.data.earnings == 0));

      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'category', 'description', 'thumbnailUrl', 'gameUrl',
          'gameOverText', 'template', 'speed', 'jump', 'gap', 'difficulty', 'control',
          'bgColor', 'map', 'pipeStyle', 'building', 'decoration', 'isEngineGame', 'isPhase2',
          'playerEmoji', 'playerBase64', 'bgBase64', 'obstacleType', 'gapSize', 'levels'
        ])
      );

      allow delete: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending'
      );
    }

    // --- user_notifications Collection ---
    // User reads own notifications and can update only 'read' to boolean; Admin creates/deletes
    match /user_notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool
      );
      allow delete: if isAdmin();
    }

    // --- king_affiliates Collection ---
    // Public reads Daraz carousel banners; writes strictly restricted to Super Admin
    match /king_affiliates/{affiliateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Blocks Collection (/blocks/{blockerUid_blockedUid}) ---
    // Only blocker can read/list/delete their own blocks; blocked users cannot enumerate who blocked them
    match /blocks/{blockId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource == null
            ? (isValidId(blockId) && blockId.matches('^' + request.auth.uid + '_.*'))
            : resource.data.blockerUid == request.auth.uid
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.blockerUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt']) &&
        isValidId(request.auth.uid) &&
        request.resource.data.blockerUid == request.auth.uid &&
        isValidId(request.resource.data.blockedUid) &&
        request.resource.data.blockedUid != request.auth.uid &&
        isValidId(blockId) &&
        blockId == request.resource.data.blockerUid + '_' + request.resource.data.blockedUid &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.blockerUid == request.auth.uid
      );
    }

    // --- Friendships & Friend Requests Collection (/friendships/{minUid_maxUid}) ---
    // Canonical sorted pair ID prevents duplicate or simultaneous cross-direction requests
    match /friendships/{pairId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource == null
            ? (isValidId(pairId) && (pairId.matches('^' + request.auth.uid + '_.*') || pairId.matches('.*_' + request.auth.uid + '$')))
            : (request.auth.uid in resource.data.users)
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() && request.auth.uid in resource.data.users
      );
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'userA', 'userB', 'users', 'status', 'requestedBy', 'targetUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(request.auth.uid) &&
        isValidId(request.resource.data.userA) &&
        isValidId(request.resource.data.userB) &&
        request.resource.data.userA < request.resource.data.userB &&
        isValidId(pairId) &&
        pairId == request.resource.data.userA + '_' + request.resource.data.userB &&
        request.resource.data.users is list &&
        request.resource.data.users.size() == 2 &&
        request.resource.data.userA in request.resource.data.users &&
        request.resource.data.userB in request.resource.data.users &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedBy == request.auth.uid &&
        isValidId(request.resource.data.targetUid) &&
        request.resource.data.targetUid != request.auth.uid &&
        request.resource.data.requestedBy in request.resource.data.users &&
        request.resource.data.targetUid in request.resource.data.users &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        !isBlockedBetween(request.resource.data.userA, request.resource.data.userB);

      // Only the recipient (targetUid) can accept a pending request; no tampering with participants
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.status == 'pending' &&
        resource.data.targetUid == request.auth.uid &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        !isBlockedBetween(resource.data.userA, resource.data.userB)
      );

      // Either participant can cancel outgoing request, reject incoming request, or remove friend
      allow delete: if isAdmin() || (
        isSignedIn() && request.auth.uid in resource.data.users
      );
    }

    // --- Follows Collection (/follows/{followerUid_targetUid}) ---
    match /follows/{followId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource == null
            ? (isValidId(followId) && (followId.matches('^' + request.auth.uid + '_.*') || followId.matches('.*_' + request.auth.uid + '$')))
            : (
                resource.data.followerUid == request.auth.uid ||
                resource.data.targetUid == request.auth.uid
              )
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.followerUid == request.auth.uid ||
          resource.data.targetUid == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['followerUid', 'targetUid', 'createdAt']) &&
        isValidId(request.auth.uid) &&
        request.resource.data.followerUid == request.auth.uid &&
        isValidId(request.resource.data.targetUid) &&
        request.resource.data.targetUid != request.auth.uid &&
        isValidId(followId) &&
        followId == request.resource.data.followerUid + '_' + request.resource.data.targetUid &&
        request.resource.data.createdAt == request.time &&
        !isBlockedBetween(request.resource.data.followerUid, request.resource.data.targetUid);
      allow update: if false;
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.followerUid == request.auth.uid ||
          resource.data.targetUid == request.auth.uid
        )
      );
    }

    // --- Statuses Collection (/statuses/{statusId}) ---
    // Multi-user feed listing is delegated to authenticated backend /api/status/feed;
    // clients can only list their own statuses directly, while single-doc gets enforce full privacy + expiry + blocks.
    match /statuses/{statusId} {
      allow get: if canViewStatusDoc(resource.data);
      allow list: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(statusId) && isValidStatusCreate(request.resource.data);
      allow update: if isAdmin() || (
        isSignedIn() && (
          // Atomic unique view increment (+1) coupled with status_views/{statusId}_{viewerUid} creation; owner cannot view own
          (
            resource.data.authorUid != request.auth.uid &&
            canViewStatusDoc(resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']) &&
            request.resource.data.viewsCount == getDocCounter(resource.data, 'viewsCount') + 1 &&
            !exists(/databases/$(database)/documents/status_views/$(statusId + '_' + request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/status_views/$(statusId + '_' + request.auth.uid))
          ) ||
          // Atomic reaction increment (+1) coupled with status_likes/{statusId}_{userUid} creation
          (
            resource.data.authorUid != request.auth.uid &&
            canViewStatusDoc(resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) &&
            request.resource.data.likesCount == getDocCounter(resource.data, 'likesCount') + 1 &&
            !exists(/databases/$(database)/documents/status_likes/$(statusId + '_' + request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/status_likes/$(statusId + '_' + request.auth.uid))
          ) ||
          // Atomic unreact decrement (-1) coupled with status_likes/{statusId}_{userUid} deletion
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) &&
            request.resource.data.likesCount == (getDocCounter(resource.data, 'likesCount') > 0 ? getDocCounter(resource.data, 'likesCount') - 1 : 0) &&
            exists(/databases/$(database)/documents/status_likes/$(statusId + '_' + request.auth.uid)) &&
            !existsAfter(/databases/$(database)/documents/status_likes/$(statusId + '_' + request.auth.uid))
          )
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // --- Status Views Collection (/status_views/{statusId}_{viewerUid}) ---
    // Deterministic doc ID prevents duplicate views; owner cannot count own view; viewer list strictly owner-only.
    match /status_views/{viewId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource == null
            ? (isValidId(viewId) && viewId.matches('.*_' + request.auth.uid + '$'))
            : (resource.data.statusOwnerUid == request.auth.uid || resource.data.viewerUid == request.auth.uid)
        )
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.statusOwnerUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(viewId) &&
        request.resource.data.keys().hasAll([
          'statusId', 'statusOwnerUid', 'viewerUid', 'viewerName', 'viewerPhoto', 'viewedAt', 'expiresAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'statusId', 'statusOwnerUid', 'viewerUid', 'viewerName', 'viewerPhoto', 'viewedAt', 'expiresAt'
        ]) &&
        isValidId(request.resource.data.statusId) &&
        isValidId(request.resource.data.statusOwnerUid) &&
        request.resource.data.viewerUid == request.auth.uid &&
        request.resource.data.statusOwnerUid != request.auth.uid &&
        viewId == request.resource.data.statusId + '_' + request.auth.uid &&
        request.resource.data.viewerName is string && request.resource.data.viewerName.size() <= 100 &&
        request.resource.data.viewerPhoto is string && request.resource.data.viewerPhoto.size() <= 1000 &&
        request.resource.data.viewedAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        exists(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)) &&
        get(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)).data.authorUid == request.resource.data.statusOwnerUid &&
        canViewStatusDoc(get(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)).data);
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.statusOwnerUid == request.auth.uid);
    }

    // --- Status Likes / Reactions Collection (/status_likes/{statusId}_{userUid}) ---
    match /status_likes/{likeId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource == null
            ? (isValidId(likeId) && likeId.matches('.*_' + request.auth.uid + '$'))
            : (resource.data.statusOwnerUid == request.auth.uid || resource.data.userUid == request.auth.uid)
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.statusOwnerUid == request.auth.uid ||
          resource.data.userUid == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        isValidId(likeId) &&
        request.resource.data.keys().hasAll([
          'statusId', 'statusOwnerUid', 'userUid', 'userName', 'userPhoto', 'emoji', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'statusId', 'statusOwnerUid', 'userUid', 'userName', 'userPhoto', 'emoji', 'createdAt', 'expiresAt'
        ]) &&
        isValidId(request.resource.data.statusId) &&
        isValidId(request.resource.data.statusOwnerUid) &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.statusOwnerUid != request.auth.uid &&
        likeId == request.resource.data.statusId + '_' + request.auth.uid &&
        request.resource.data.userName is string && request.resource.data.userName.size() <= 100 &&
        request.resource.data.userPhoto is string && request.resource.data.userPhoto.size() <= 1000 &&
        request.resource.data.emoji in ['❤️', '🔥', '👑', '😂', '😮', '👏'] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        exists(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)) &&
        get(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)).data.authorUid == request.resource.data.statusOwnerUid &&
        canViewStatusDoc(get(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)).data);
      allow update: if isSignedIn() &&
        resource.data.userUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji', 'createdAt']) &&
        request.resource.data.emoji in ['❤️', '🔥', '👑', '😂', '😮', '👏'] &&
        request.resource.data.createdAt == request.time &&
        !isBlockedBetween(request.auth.uid, resource.data.statusOwnerUid);
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.userUid == request.auth.uid ||
          resource.data.statusOwnerUid == request.auth.uid
        )
      );
    }

    // --- Status Private Replies Collection (/status_replies/{replyId}) ---
    // Strictly readable only by sender and status owner.
    match /status_replies/{replyId} {
      allow get, list: if isAdmin() || (
        isSignedIn() && (
          resource.data.statusOwnerUid == request.auth.uid ||
          resource.data.senderUid == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        isValidId(replyId) &&
        request.resource.data.keys().hasAll([
          'statusId', 'statusOwnerUid', 'senderUid', 'senderName', 'senderPhoto', 'message', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'statusId', 'statusOwnerUid', 'senderUid', 'senderName', 'senderPhoto', 'message', 'createdAt', 'expiresAt'
        ]) &&
        isValidId(request.resource.data.statusId) &&
        isValidId(request.resource.data.statusOwnerUid) &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.statusOwnerUid != request.auth.uid &&
        request.resource.data.senderName is string && request.resource.data.senderName.size() <= 100 &&
        request.resource.data.senderPhoto is string && request.resource.data.senderPhoto.size() <= 1000 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 1 &&
        request.resource.data.message.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        exists(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)) &&
        get(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)).data.authorUid == request.resource.data.statusOwnerUid &&
        canViewStatusDoc(get(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)).data);
      allow update: if false;
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.statusOwnerUid == request.auth.uid
        )
      );
    }

    // --- Notifications Collection (/notifications/{notificationId}) ---
    // Recipient reads and marks read; actors can only emit verified status/social notifications when not blocked.
    match /notifications/{notificationId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource == null
            ? isValidId(notificationId)
            : resource.data.recipientUid == request.auth.uid
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.recipientUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isSignedIn() &&
        isValidId(notificationId) &&
        request.resource.data.keys().hasAll([
          'recipientUid', 'actorUid', 'actorName', 'actorPhoto', 'type', 'statusId',
          'title', 'body', 'read', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'recipientUid', 'actorUid', 'actorName', 'actorPhoto', 'type', 'statusId',
          'title', 'body', 'emoji', 'read', 'createdAt', 'expiresAt'
        ]) &&
        isValidId(request.resource.data.recipientUid) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.recipientUid != request.auth.uid &&
        request.resource.data.actorName is string && request.resource.data.actorName.size() <= 100 &&
        request.resource.data.actorPhoto is string && request.resource.data.actorPhoto.size() <= 1000 &&
        request.resource.data.type in ['status_reaction', 'status_reply'] &&
        isValidId(request.resource.data.statusId) &&
        request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120 &&
        request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 300 &&
        (!('emoji' in request.resource.data) || (request.resource.data.emoji is string && request.resource.data.emoji.size() <= 16)) &&
        request.resource.data.read == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        !isBlockedBetween(request.auth.uid, request.resource.data.recipientUid) &&
        exists(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)) &&
        get(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)).data.authorUid == request.resource.data.recipientUid &&
        canViewStatusDoc(get(/databases/$(database)/documents/statuses/$(request.resource.data.statusId)).data) &&
        (
          request.resource.data.type != 'status_reaction' ||
          exists(/databases/$(database)/documents/status_likes/$(request.resource.data.statusId + '_' + request.auth.uid)) ||
          existsAfter(/databases/$(database)/documents/status_likes/$(request.resource.data.statusId + '_' + request.auth.uid))
        )
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.recipientUid == request.auth.uid ||
          resource.data.actorUid == request.auth.uid
        )
      );
    }

    // --- Bottom Fallback Rule ---
    // Restricted to Super Admin to protect private user data (emails, notifications, drafts)
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
