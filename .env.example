# GEMINI_API_KEY: Primary runtime Gemini API key (Vercel / server env secret).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional additional server-side fallback key slots (Admin Vault also manages multiple encrypted keys):
# GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""
# GEMINI_API_KEY_4=""

# AI_VAULT_SECRET: Required in production for persistent AES-256-GCM encryption/decryption of Admin Vault keys.
AI_VAULT_SECRET=""

# UPSTASH_REDIS_REST_URL & UPSTASH_REDIS_REST_TOKEN: Upstash Redis Free REST credentials for persistent encrypted AI Vault storage on Vercel.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI_VAULT_DIR: Optional local directory override for .king-ai-vault.enc.json in Express development.
AI_VAULT_DIR=""

# APP_URL: Canonical production URL (e.g. https://king-app-full.vercel.app).
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Optional comma-separated list of additional allowed CORS origins.
ALLOWED_ORIGINS=""

# FIREBASE_SERVICE_ACCOUNT_KEY: JSON string of Firebase Admin service account credentials (required on Vercel for Firestore Admin access).
FIREBASE_SERVICE_ACCOUNT_KEY=""

# CLOUDINARY_API_KEY & CLOUDINARY_API_SECRET: Server-side only (never expose to VITE_* client env).
# Required for signed Status uploads, authenticated media delivery, 24h expiry cleanup, and AI large-image offload (>3.4 MB).
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# META_APP_ID, META_APP_SECRET & META_VERIFY_TOKEN: Meta Business / Facebook & Instagram OAuth integration.
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""

# CRON_SECRET: Bearer token to authorize scheduled /api/status/cleanup cron calls.
CRON_SECRET=""
